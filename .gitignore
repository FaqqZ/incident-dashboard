node_modules/
dist/
.env
*.log
.DS_Store

# Vercel
.vercel

# server/data/ es el directorio de RUNTIME: en el host es el punto de montaje
# del disco persistente y en local se siembra solo al arrancar. No se versiona.
server/data/

# Los Excel de server/seed/ NO se versionan: el repositorio es público y traen
# datos reales — direcciones de cámaras y, en Defensa Civil, nombre y domicilio
# de cada denunciante. Viajan solo en el deploy por CLI (`vercel --prod`), que
# se rige por .vercelignore y no por este archivo.
# Ojo: incidentes.xlsx y siniestralidad.xlsx estuvieron versionados antes de
# esta regla y siguen en el historial de git.
server/seed/*.xlsx
