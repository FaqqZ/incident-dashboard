# Puerto del servidor
PORT=4000

# Ruta al Excel de incidentes (opcional; por defecto usa ./data/incidentes.xlsx)
# EXCEL_PATH=/ruta/absoluta/a/incidentes.xlsx

# Token para proteger la carga de nuevos Excel (/api/upload).
# Si lo dejás vacío, la carga queda abierta (solo para desarrollo local).
UPLOAD_TOKEN=cambiame-por-un-token-secreto
